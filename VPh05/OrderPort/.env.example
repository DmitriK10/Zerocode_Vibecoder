# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=orderport
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Приложение
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

# OpenAI Proxy
OPENAI_API_BASE=https://proxypi.ru/v1
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-3.5-turbo-16k
OPENAI_MAX_TOKENS=4000

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin_password

# Явная строка подключения (переопределяет отдельные параметры)
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@postgres:5432/orderport