# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=orderport
POSTGRES_HOST=postgres   # внутри docker-compose
POSTGRES_PORT=5432

# Приложение
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

# JWT (минимум 32 символа, сгенерируйте уникальный ключ)
SECRET_KEY=your_generated_secret_key_here_1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI Proxy
OPENAI_API_BASE=https://proxypi.ru/v1
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-3.5-turbo-16k
OPENAI_MAX_TOKENS=4000

# Явная строка подключения к PostgreSQL (внутри docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@postgres:5432/orderport