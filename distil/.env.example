# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=distil
APP_ENV=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins.
# Local dev defaults are added automatically if you leave this empty.
# Production example:
#   CORS_ORIGINS=https://distil.example.com,https://www.distil.example.com
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development (docker compose): use the compose service name `db`.
# For a managed instance, replace with e.g.:
#   postgresql+asyncpg://user:pass@ep-xxx.neon.tech/distil?ssl=require
DATABASE_URL=postgresql+asyncpg://distil:distil@db:5432/distil
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# LLM (proxyapi.ru — OpenAI-compatible proxy)
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.proxyapi.ru/openai/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini
LLM_ALLOWED_MODELS=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0

# ---------------------------------------------------------------------------
# Text limits
# ---------------------------------------------------------------------------
TEXT_MIN_LENGTH=10
TEXT_MAX_LENGTH=20000

# ---------------------------------------------------------------------------
# Audit
# ---------------------------------------------------------------------------
AUDIT_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# HTTP Basic Auth for web panel and export endpoints.
# When ENABLED=true, ALL of username/password must be set (password >= 8 chars).
# Leave ENABLED=false for local development.
# ---------------------------------------------------------------------------
API_AUTH_ENABLED=false
API_AUTH_USERNAME=
API_AUTH_PASSWORD=