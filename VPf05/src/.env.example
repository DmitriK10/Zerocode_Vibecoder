# Обязательно: API-ключ OpenAI (или совместимого сервиса)
OPENAI_API_KEY=sk-...

# Опционально: базовый URL (для прокси или локальных моделей)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Модель (по умолчанию gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Температура (0.0-1.0)
TEMPERATURE=0.3

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO