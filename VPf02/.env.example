# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# OpenAI API через ProxyAPI (рекомендуемый способ)
# Получить ключ на https://console.proxyapi.ru/keys
OPENAI_API_KEY=sk-ваш_ключ_от_proxyapi
OPENAI_BASE_URL=https://openai.api.proxyapi.ru/v1

# Альтернативно: GenAPI (если не используете ProxyAPI)
# GENAPI_KEY=ваш_ключ_GenAPI
# GENAPI_URL=https://api.genapi.ai/v1

# Базовый URL для Telegram API через Cloudflare Worker (для обхода блокировок)
# Создать Worker по инструкции и указать его URL + /bot в конце
TELEGRAM_API_BASE_URL=https://ваш-worker.workers.dev/bot