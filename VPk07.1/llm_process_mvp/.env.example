# Скопируй этот файл в .env рядом с ним и заполни реальным ключом.
# .env находится в .gitignore — секрет в репозиторий не попадёт.
#
# Обязательно:
PROXY_API_KEY=sk-REPLACE_ME
#
# Опционально (у всех есть рабочие дефолты в src/config.py):
PROXY_API_BASE_URL=https://api.proxyapi.ru/openai/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
#
# Переопределить путь к БД (по умолчанию — <project>\data\processing.db):
# DB_PATH=C:\Users\ADATA\Documents\Zerocoder_Vibecoder\VPk07.1\llm_process_mvp\data\processing.db